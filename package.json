{
  "name": "presscentra",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:web": "npm --workspace services/web run dev",
    "dev:api": "npm --workspace services/api run dev",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.2.1"
  }
}
